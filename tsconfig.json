{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": [
    "games/**/*.ts",
    "games/**/*.tsx",
    "server/**/*.ts",
    "tests/**/*.ts",
    "host/**/*.tsx",
    "host/**/*.ts"
  ]
}
